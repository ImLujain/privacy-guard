{
    "manifest_version": 3,
    "name": "PrivacyGuard",
    "description": "Detects web trackers, audits browser fingerprinting access, and randomizes device identifiers.",
    "version": "0.0.1",
    "icons":{
        "128":"./logo-128.png",
        "48":"./logo-48.png",
        "32":"./logo-32.png",
        "16":"./logo-16.png"
    },
    "background": {
        "service_worker": "/background.js"
    },
    "action": {
        "default_popup": "popup.html",
        "default_icon": {
            "16": "./logo-16.png",
            "32": "./logo-32.png",
            "48": "./logo-48.png",
            "128": "./logo-128.png"
        }
    },
    "content_scripts": [
        {
            "matches": ["<all_urls>"],
            "js": ["/content.js"],
            "run_at": "document_start"
        }
    ],
    "web_accessible_resources": [
        {
            "resources": [
                "anti-detection.js",
                "profile1.js",
                "profile2.js",
                "profile3.js",
                "profile4.js",
                "profile5.js",
                "PrivacyGuard-detect-fp-calls.js"
            ],
            "matches": ["<all_urls>"]
        }
    ],
    "permissions": [
        "declarativeNetRequest",
        "declarativeNetRequestWithHostAccess",
        "declarativeNetRequestFeedback",
        "storage",
        "unlimitedStorage",
        "tabs",
        "scripting",
        "webRequest",
        "activeTab"
    ],
    "host_permissions": [
        "*://*/*",
        "http://localhost:*/*",
        "http://127.0.0.1:*/*"
    ]
}